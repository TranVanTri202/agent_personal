# --- CORE APPLICATION ---
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=info

# --- ZALO OFFICIAL BOT ---
# REQUIRED: Get fresh bot token from Zalo Bot Creator. DO NOT use leaked/old tokens.
ZALO_BOT_TOKEN=
# Mode: "polling" (recommended for local dev) or "webhook"
ZALO_MODE=polling
ZALO_POLL_TIMEOUT_SECONDS=30
ZALO_WEBHOOK_URL=
ZALO_WEBHOOK_SECRET=
ZALO_HTTP_TIMEOUT_MS=45000
ZALO_MAX_MESSAGE_LENGTH=2000
BOT_ACCESS_MODE=private
GROUP_ACCESS_ENABLED=false
# Optional bootstrap user ID if not using pairing code CLI
ALLOWED_ZALO_USER_IDS=

# --- POSTGRESQL & REDIS ---
POSTGRES_USER=personal_agent
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=personal_agent
POSTGRES_PORT=5433
# Connection string for Prisma and local NestJS app
DATABASE_URL=postgresql://personal_agent:replace_with_secure_password@localhost:5433/personal_agent?schema=public
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
WORKER_CONCURRENCY=1

# ================= OPENROUTER =================
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=My Zalo Personal Agent
OPENROUTER_APP_URL=

# ================= CHOOSE MODE =================
# single | task
LLM_ROUTING_MODE=single

# Khi single: tất cả bước dùng model này (ví dụ: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, google/gemini-flash-1.5)
LLM_SINGLE_MODEL=openai/gpt-4o-mini

# Khi task: model mặc định nếu category không có rule
LLM_DEFAULT_MODEL=openai/gpt-4o-mini

# ================= TASK ROUTING =================
# rules | adaptive (adaptive là tùy chọn, mặc định rules)
LLM_TASK_ROUTING_STRATEGY=rules
LLM_TASK_ROUTING_CONFIG=./config/llm-routing.json

# ================= EXECUTION =================
LLM_REQUEST_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_STEPS=15
LLM_MAX_TOOL_CALLS=30
LLM_MAX_CONCURRENT_REQUESTS=3

# ================= COST & PRIVACY =================
LLM_MAX_USD_PER_REQUEST=0.10
LLM_DAILY_BUDGET_USD=1.00
LLM_MONTHLY_BUDGET_USD=20.00
OPENROUTER_REQUIRE_ZDR=false
OPENROUTER_DENY_DATA_COLLECTION=true
OPENROUTER_ALLOW_PROVIDER_FALLBACKS=true
LLM_CROSS_MODEL_FALLBACK_ENABLED=false

# ================= MODEL CATALOG =================
LLM_MODEL_CATALOG_CACHE_TTL_MINUTES=360
LLM_VALIDATE_MODEL_ON_STARTUP=true

# ================= AUDIT =================
LLM_LOG_PROMPT_CONTENT=false
LLM_LOG_TOOL_PAYLOAD=false
LLM_TRACK_USAGE=true

# --- STORAGE (SUPABASE TEMPORARY STORAGE 24H) ---
# Supabase chỉ dùng để lưu file tạm (tự động xóa sau 24h); PostgreSQL vẫn là DB hiện tại
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_KEY
SUPABASE_STORAGE_BUCKET=agent-temp
LOCAL_STORAGE_ROOT=./data

# --- GOOGLE / GMAIL (OPTIONAL) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# AES-256-GCM encryption key for tokens at rest (32 bytes hex or 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- OPTIONAL TOOLS ---
GITHUB_TOKEN=
WEB_SEARCH_API_KEY=
SPEECH_API_KEY=
IMAGE_API_KEY=

# ================= OPENROUTER IMAGE GENERATION & EDITING =================
# Model ID hợp lệ tại OpenRouter Image Models (ví dụ: qwen/qwen-image-2.1-turbo, google/gemini-2.5-flash-image)
OPENROUTER_IMAGE_MODEL=qwen/qwen-image-2.1-turbo
# Tùy chọn: model riêng cho edit (hỗ trợ input_references). Nếu để trống sẽ dùng OPENROUTER_IMAGE_MODEL
OPENROUTER_IMAGE_EDIT_MODEL=

# --- FEATURE FLAGS ---
GMAIL_ENABLED=false
GITHUB_ENABLED=false
WEB_SEARCH_ENABLED=false
VOICE_ENABLED=false
ALLOW_EMAIL_AUTO_SEND=false
REQUIRE_APPROVAL_FOR_EXTERNAL_WRITES=true
