{
  "name": "personal-zalo-agent",
  "version": "1.0.0",
  "description": "Personal AI Agent via Zalo Bot Official API (Local-First)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r dotenv/config dist/src/main",
    "start:worker": "node -r dotenv/config dist/src/worker",
    "lint": "eslint \"{src,apps,libs,tests,scripts}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./tests/jest-e2e.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "setup": "ts-node -r dotenv/config scripts/setup.ts",
    "doctor": "ts-node -r dotenv/config scripts/doctor.ts",
    "zalo:test": "ts-node -r dotenv/config scripts/zalo-test.ts",
    "zalo:webhook:info": "ts-node -r dotenv/config scripts/zalo-webhook-info.ts",
    "zalo:webhook:set": "ts-node -r dotenv/config scripts/zalo-webhook-set.ts",
    "zalo:webhook:delete": "ts-node -r dotenv/config scripts/zalo-webhook-delete.ts",
    "owner:pair-code": "ts-node -r dotenv/config scripts/owner-pair-code.ts",
    "llm:validate-routing": "ts-node -r dotenv/config scripts/llm-validate-routing.ts",
    "llm:list-models": "ts-node -r dotenv/config scripts/llm-list-models.ts",
    "llm:smoke": "ts-node -r dotenv/config scripts/llm-smoke.ts",
    "test:image:live": "ts-node -r dotenv/config scripts/image-smoke.ts",
    "storage:setup": "ts-node -r dotenv/config scripts/storage-setup.ts",
    "storage:cleanup": "ts-node -r dotenv/config scripts/storage-cleanup.ts",
    "storage:check": "ts-node -r dotenv/config scripts/storage-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/schedule": "^5.0.1",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.118.0",
    "axios": "^1.8.1",
    "bullmq": "^5.41.6",
    "docx": "^9.2.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "googleapis": "^146.0.0",
    "ioredis": "^5.6.0",
    "nestjs-pino": "^4.3.0",
    "openai": "^4.86.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.33.5",
    "zalo-bot-js": "^0.2.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prisma": "^6.4.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    }
  }
}
